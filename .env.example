# Copy to .env (gitignored) and fill in. Never commit .env.

# Phase 1: JSearch job search (LinkedIn/Indeed/Glassdoor postings via Google for Jobs).
# openwebninja.com -> sign up -> API key. Free: 200 requests/month. Or set RAPIDAPI_KEY instead.
OPENWEBNINJA_API_KEY=
RAPIDAPI_KEY=

# Phase 4: the agent run step (Cursor SDK). Dashboard -> Integrations -> API keys.
CURSOR_API_KEY=

# Phase 4: phone push. Pick a long random topic; anyone who knows it can read your pushes.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Phase 4: dead-man's switch. healthchecks.io free check; pushes you if the mini goes quiet.
HEALTHCHECK_URL=

# Phase 5: Gmail MCP. Google Cloud console -> OAuth client (Desktop app), Gmail API enabled.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=harshal.thachapully@gmail.com

# Mac mini backups: private repo for data/ and out/. Use a fine-grained token scoped to that repo only.
# https://x-access-token:<token>@github.com/<you>/job-agent-data.git
DATA_REPO_URL=

TZ=America/New_York
